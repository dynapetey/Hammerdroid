<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GtFlash" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#050A10</item>
        <item name="android:statusBarColor">#050A10</item>
        <item name="android:windowBackground">#050A10</item>
    </style>
    <style name="Theme.GtFlash.Splash" parent="@style/Theme.GtFlash">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
